    "g00.l001": "──なにかが、聞こえる。",
    "g00.l002": "泣き声？　猫みたいな…。",
    "g00.l003": "──違う、子どもの声だ。",

    "g00.c001": "目を開ける",
    "g00.c002": "目を開けない",

    "g00.ui001": "どちらかを選んでください",

    "g00.l004": "…ここは……？",
    "g00.l005a": "目を開けたとたん、",
    "g00.l005b": "肌にまとわりつくような",
    "g00.l005c": "冷たい感覚に気づく。",

    "g00.l006a": "土と、",
    "g00.l006b": "湿った木の匂いがする。",

    "g00.l007a": "自分の呼吸と心臓の音が",
    "g00.l007b": "やけにはっきり聞こえて、",

    "g00.l008a": "とても静かなのに、",
    "g00.l008b": "うるさい。",

    "g00.l009": "……。",
    "g00.l010": "………。",

    "g01.l001": "──どうして、こんなところに？",
    "g01.l002a": "さっき確かに",
    "g01.l002b": "眠ったはずなのに…。",

    "g01.l004a": "とりあえず、",
    "g01.l004b": "あたりを見回してみる。",
    "g01.l005": "…また、聞こえる。",

    "g01.c001": "声のする方へ歩く",
    "g01.c002": "その場にとどまる",

    // Additional display text
    "g01.l003": "じゃあこれは…夢？",
    "g01.l006a": "霧をかき分けるように、",
    "g01.l006b": "声のするほうへ歩き出す。",
    "g01.l007a": "見えない中を",
    "g01.l007b": "歩くのは危ないし、怖い。",
    "g01.l008": "……でも。",
    "g01.l009a": "このまま立っていても、",
    "g01.l009b": "なにも変わらない気がした。",
    "g01.l010a": "意を決して、",
    "g02.l001a": "暗さと濃い霧のせいで、",
    "g02.l001b": "どこを歩いているのかわからない。",
    "g02.l002a": "だけど、だんだんと",
    "g02.l002b": "声が近づいてきて──。",
    "g02.l003": "霧の向こうに、小さな影が見える。",
    "g02.l004a": "木の根もとに膝を抱えてうずくまる、",
    "g02.l004b": "──子どもだ。",
    "g02.c001": "声をかける",
    "g02.c002": "声をかけない",
    "g02.l005": "大丈夫？",
    "g02.l006a": "背中に向かって声をかけると",
    "g02.l006b": "驚いたのか、ほんの少し肩が上がる。",
    "g02.l007": "「う……ぐす…」",
    "g02.l008a": "振り向いたその顔は、",
    "g02.l008b": "薄暗くてよく見えないけれど",
    "g02.l008c": "頬がびしょびしょに濡れていることはわかる。",
    "g03.l001": "「…ぐす…ひっく…」",
    "g03.l002a": "声をかけたものの、",
    "g03.l002b": "大粒の涙を流す子どもを見つめるだけで",
    "g03.l002c": "どうしてあげればいいのかわからない。",
    "g03.c001": "迷子かな？",
    "g03.l003a": "自分もここがどこだかわからないのに",
    "g03.l003b": "変な質問だと思いながら、聞いてみる。",
    "g03.l004": "「…なくし、ちゃった…」",
    "g03.l005": "子どもは、言葉を詰まらせながらそうつぶやく。",
    "g03.c002": "なにを？",
    "g03.l006": "なくしたって、なにを？",
    "g03.l007": "「………わかんない」",
    "g03.l008": "え？",
    "g03.l009a": "「どうしよう、うっ、",
    "g03.l009b": "なくしちゃった…ううっ…」",
    "g03.l010a": "なにをなくしたかわからないのに、",
    "g03.l010b": "なくしたことが悲しくて泣いてる…？",
    "g03.l011": "「うっ、ぐす…ひっく…」",
    "g03.l012a": "どうしてあげたらいいのかわからなくて、",
    "g03.l012b": "だんだんこっちが泣きたくなってくる。",
    "g03.c003": "家族はどこ？",
    "g03.l013": "家族はどこにいるの？",
    "g03.l014": "「…わかんない」",
    "g03.l015a": "「いたかもしれない。",
    "g03.l015b": "…でも、今はひとりぼっち」",
    "g03.l016": "そっか…。",
    "g03.l017": "ひとりぼっちなのは、自分も同じだ。",
    "g03.l018a": "「なくしちゃった…",
    "g03.l018b": "なくなっちゃった…ぐすっ…」",
    "g03.l019a": "だけど不思議と、",
    "g03.l019b": "自分より困っている人を見ると",
    "g03.l019c": "自分の不安は小さく思えてくる。",
    "g03.l020": "なんとかしてあげたい。",
    "g03.c004": "一緒に探そう",
    "g03.c005": "できることはある？",
    "g03.l021": "なくしたもの、一緒に探そう。",
    "g03.l022": "「……ほんと？」",
    "g03.l023": "なにか、できることはある？",
    "g03.l024": "「………」",
    "g03.l025": "「……いっしょに、さがしてほしい」",
    "g03.l026": "わかった、一緒に探そう。",
    "g03.l027a": "びしょびしょに濡れた瞳が",
    "g03.l027b": "大きく開かれて、きらっと光る。",
    "g03.l028": "大きくうなずいてみせると、",
    "g03.l029": "「わあ…やったあ！」",
    "g03.l030a": "跳ねるような高い声が",
    "g03.l030b": "霧の中に響く。",
    "g03.l031a": "涙はぴたりと止まって、",
    "g03.l031b": "ころころと嬉しそうに笑う。",
    "g03.l032": "言ってみて良かった。",
    "g03.l033": "「えへへ」",
    "g03.l034a": "よっぽど嬉しかったのか、",
    "g03.l034b": "もたれるように体をすり寄せてくる。",
    "g03.l035a": "触れたところがあったかくて",
    "g03.l035b": "なんだかほっとする。",
    "g03.l036": "「ん」",
    "g03.l037a": "そのまま手を握ってきて、",
    "g03.l037b": "指先が小さな指に包まれる。",
    "g03.c006": "握り返す",
    "g03.c007": "そのままにする",
    "g03.l038a": "これからよろしく、という感じで",
    "g03.l038b": "小さな手をしっかり握り返すと、",
    "g03.l039": "「きゃきゃっ」",
    "g03.l040a": "さっきまであんなに",
    "g03.l040b": "泣いていたのが嘘みたいに、",
    "g03.l040c": "元気よく笑う。",
    "g03.l041a": "よっぽど心細かったんだろう。",
    "g03.l041b": "握られた指をそのままにする。",
    "g04.l001": "「ねえ、なんて呼べばいい？」",
    "g04.l002a": "指を握ったまま飛び跳ねて、",
    "g04.l002b": "嬉しそうに尋ねてくる。",
    "g04.l003": "なんて呼んでほしいか…。",
    "g04.l004a": "「あれ、まだ教えてもらってないよ？",
    "g04.l004b": "なんて呼べばいい？」",
    "g04.c001": "{value}でいい",
    "g04.l005": "{value}って、呼んでくれる？",
    "g04.l006": "「{value}さん、でいいの？」",
    "g04.c002": "やっぱり変える",
    "g04.l007": "うん、よろしく。",
    "g04.l008": "「よろしくね、{value}さん！」",
    "g04.l009": "やっぱり変えよう。",
    "g05.l001a": "濃い霧の向こうに",
    "g05.l001b": "目をこらしてみる。",
    "g05.l002a": "その先に",
    "g05.l002b": "なにがあるのかはわからない。",
    "g05.l003a": "だけどここにいても、この子の",
    "g05.l003b": "\"なくしたもの\"は見つからないだろう。",
    "g05.l004a": "とりあえず、ここから",
    "g05.l004b": "出られる道を探そう。",
    "g05.l005a": "…そもそも、",
    "g05.l005b": "この子はどこから来たんだろう？",
    "g05.c001": "どこから来たの？",
    "g05.c002": "来た道はわかる？",
    "g05.l006": "きみはどこから来たの？",
    "g05.l007a": "そう聞くと、",
    "g05.l007b": "きょとんとした顔で少し上を向く。",
    "g05.l008": "「…どこ…？」",
    "g05.l009a": "「わかんない。",
    "g05.l009b": "どこだろ？」",
    "g05.l010": "…そっか。",
    "g05.l011": "「…道…？」",
    "g05.l012a": "ここに来るまで、どんな道を",
    "g05.l012b": "来たか覚えてる？",
    "g05.l013a": "「ううん、わかんない。",
    "g05.l014": "それなら、一緒に探すしかない。",
    "g05.c003": "探検してみよう",
    "g05.c004": "歩いてみよう",
    "g05.l015": "一緒に探検してみよう。",
    "g05.l016": "「うん！　探検！」",
    "g05.l017a": "その言葉が魅力的に聞こえたのか",
    "g05.l017b": "にっこり笑って",
    "g05.l017c": "指を握る手に力が込められる。",
    "g05.l018a": "その反応にほっとして、",
    "g05.l018b": "手をつないだまま歩き出す。",
    "g05.l019": "一緒に歩いてみようか。",
    "g05.l020": "「うん」",
    "g05.l021a": "その答えを聞いて、",
    "g05.l022a": "二人でゆっくり、",
    "g05.l022b": "霧の中を歩いてみる。",
    "g05.l023a": "たまに、すねあたりに",
    "g05.l023b": "草の当たる感触がある。",
    "g05.l024a": "もしかすると、",
    "g05.l024b": "人が歩いていい道じゃ",
    "g05.l024c": "ないのかもしれない。",
    "g05.l025a": "このまま歩き続けて、",
    "g05.l025b": "どこへ向かうんだろう？",
    "g05.l026a": "肌にまとわりつく湿り気が",
    "g05.l026b": "余計に焦らせて、",
    "g05.l027a": "暑さは感じないのに",
    "g05.l027b": "額からじわりと汗がしみ出す。",
    "g05.l028a": "自分の不安が伝わってしまいそうで、",
    "g05.l028b": "そっと手をほどく。",
    "g05.l029": "「…だいじょうぶ？」",
    "g05.l030a": "心配そうに顔をのぞき込まれる。",
    "g05.l030b": "さっきまではこの子の方が",
    "g05.l030c": "不安で仕方なさそうだったのに。",
    "g05.l031a": "大丈夫じゃない、と答えたいけど",
    "g05.l031b": "もうあの泣き顔は見たくない。",
    "g05.l032": "かと言って、大丈夫だとも答えられない。",
    "g05.l033": "なにも言えずにいると、",
    "g05.l034": "「みつからないのかなあ」",
    "g05.l035a": "小さなつぶやきが、",
    "g05.l035b": "霧の中に響く。",
    "g05.l036a": "──せめて、この子の不安は",
    "g05.l036b": "少しでも軽くしてあげたい。",
    "g05.c005": "まだ思い出せない？",
    "g05.c006": "なにか思い出した？",
    "g05.l037a": "なくしたものがなにか、",
    "g05.l037b": "まだ思い出せない？",
    "g05.l038": "「……うん」",
    "g05.l039a": "なくしたものがなにか、",
    "g05.l039b": "思い出した？",
    "g05.l040": "「……ううん」",
    "g05.l041": "なにか、ヒントはないかな。",
    "g05.l042": "「ヒント？」",
    "g05.l043a": "たとえば…大きさとか、",
    "g05.l043b": "色とか形とか、匂いとか…。",
    "g05.l044a": "誰かにもらったとか、",
    "g05.l044b": "自分で買ったとか。",
    "g05.l045": "「…………」",
    "g05.l046a": "考え込んでいる様子を",
    "g05.l046b": "祈るような気持ちで見つめる。",
    "g05.l047a": "せめてこの子の探しものが見つかれば",
    "g05.l047b": "ちょっとは気持ちが軽くなる気がする。",
    "g05.l048": "「なくしたくない、もの」",
    "g05.l049": "ヒント、それだけ？",
    "g05.l050a": "「ねえ、{value}さんが",
    "g05.l050b": "なくしたくないものって、なに？」",
    "g05.l051": "自分が、なくしたくないもの？",
    "g05.l052a": "「うん。",
    "g05.l052b": "もしかしたら、同じものかもしれないから」",
    "g05.l053": "…なるほど。",
    "g05.l054a": "ヒントになるのかわからないけど",
    "g05.l054b": "考えてみよう。",
    "g05.l055a": "なくしたくないもの。",
    "g05.l055b": "…つまり、なくすと困るもの？",
    "g05.c007": "お金",
    "g05.c008": "学生証",
    "g05.c009": "スマホ",
    "g05.l056": "お金かな。",
    "g05.l057": "「ちがう」",
    "g05.l058a": "即答。",
    "g05.l058b": "なんだか申し訳ない気持ちになる。",
    "g05.l059a": "学生証かな。",
    "g05.l059b": "身分を証明するものだから。",
    "g05.l060": "「うーん、ちがうかな」",
    "g05.l061": "そうじゃないとしたら…。",
    "g05.l062a": "スマホかな。",
    "g05.l062b": "必要なものが全部入ってるから。",
    "g05.l063": "「そういうのじゃない…」",
    "g05.l064": "…なんだろう。",
    "g05.l065a": "お金より、学生証より、スマホより",
    "g05.l065b": "なくしたくないもの。",
    "g05.l066a": "なくしてしまった時に、",
    "g05.l066b": "あんなに悲しくなるもの…。",
    "g05.l067a": "目を開ける前に聞いた、",
    "g05.l067b": "あの泣き声を思い出す。",
    "g05.l068a": "「…かわりがないもの…",
    "g05.l068b": "だった気がする」",
    "g05.l069": "──かわりがないもの。",
    "g05.l070a": "つまり代わりがきかない、",
    "g05.l070b": "代わりが存在しないもの、ってことか。",
    "g05.l071a": "確かに、お金はなくなったら困るけど",
    "g05.l071b": "また手に入れる方法がある。",
    "g05.l072a": "学生証も、教務課で申請すれば",
    "g05.l072b": "再発行してもらえる。",
    "g05.l073a": "スマホも、バックアップしていれば",
    "g05.l073b": "中身は復旧できる。",
    "g05.l074a": "──じゃあ、本当に",
    "g05.l074b": "かわりがないもの、って",
    "g05.l074c": "なんなんだろう？",
    "g05.l075": "「…なんだろう？」",
    "g05.l076a": "こちらの心を読んでいるような",
    "g05.l076b": "タイミングで、問いかけられる。",
    "g05.c010": "一緒に考えよう",
    "g05.c011": "思いつかない",
    "g05.l077": "一緒に考えてみようか。",
    "g05.l078": "「うん！」",
    "g05.l079": "たとえば……。",
    "g05.l080": "思いつかないな…。",
    "g05.l081": "「じゃあ、一緒に考えようよ」",
    "g05.l082a": "二人なら、思いつくかもしれない。",
    "g05.l082b": "その言葉に力強くうなずいた。",
    "g05.l083": "「たとえば…」",
    "g05.l084a": "ゆっくり、お互いが",
    "g05.l084b": "思いついたものを挙げていく。",
    "g05.c012": "大切な人",
    "g05.c013": "贈りもの",
    "g05.c014": "言葉",
    "g05.c015": "宝物",
    "g05.c016": "目標",
    "g05.c017": "思い出の場所",
    "g05.l085a": "二人で考えたおかげで、",
    "g05.l085b": "いろんなものが思い浮かぶ。",
    "g05.l086a": "「そっか…",
    "g05.l086b": "そう、なのかも」",
    "g05.l087a": "隣で、目を丸く開いて",
    "g05.l087b": "小さくつぶやく。",
    "g05.l088": "なにか、思い出せそう？",
    "g05.l089a": "「…ねえ、{value}さんの",
    "g05.l089b": "なくしたくないものは、",
    "g05.l089c": "この中にある？」",
    "g05.l090a": "──自分が、",
    "g05.l090b": "なくしたくないもの…。",
    "g05.l091a": "「なくしたくない、大切な人。",
    "g05.l091b": "なくしたくない、贈りもの…",
    "g05.l091c": "なくしたくない、言葉とか」",
    "g05.l092": "そうだな…。",
    "g05.c018": "ある",
    "g05.c019": "多分ある",
    "g05.l093": "ある。",
    "g05.l094": "「ほんと？」",
    "g05.l095a": "答えると、",
    "g05.l095b": "ぱあっと目を輝かせる。",
    "g05.l096a": "「ねえ、もっと教えて！",
    "g05.l096b": "{value}さんの",
    "g05.l096c": "なくしたくないもののこと！」",
    "g05.l097a": "こちらの手をぎゅっと握って",
    "g05.l097b": "引っ張るように揺さぶってくる。",
    "g05.l098": "多分…あるかも。",
    "g05.l099": "「かも…？」",
    "g05.l100b": "不安そうに声を震わせる。",
    "g05.l101a": "うーん…",
    "g05.l101b": "そんな反応をされると…。",
    "g05.c020": "ある気がしてきた",
    "g05.l102": "…ある気がしてきた。",
    "g06.l001a": "「この中からひとつ、",
    "g06.l001b": "選んでみて？」",
    "g06.l002a": "なくしたくない、",
    "g06.l002b": "大切な人がいるよ。",
    "g06.l003a": "「{value}さんの",
    "g06.l003b": "大切な人って、どんな人？」",
    "g06.l004": "どんな人…。",
    "g06.l005a": "あの人の顔や",
    "g06.l005b": "一緒に過ごした時間を、",
    "g06.l005c": "思い浮かべてみる。",
    "g06.l006a": "大切な人が、",
    "g06.l006b": "もう一人いるよ。",
    "g06.l007a": "「他にもいるの？　すごい！",
    "g06.l007b": "その人のこと、教えて！」",
    "g06.l008a": "なくしたくない、",
    "g06.l008b": "贈りものがあるよ。",
    "g06.l009a": "「どんなもの？",
    "g06.l009b": "どんな人からもらったの？」",
    "g06.l010": "どんなもの…。",
    "g06.l011a": "贈ってくれた人のことや",
    "g06.l011b": "なくしたくない理由を、考えてみる。",
    "g06.l012a": "もうひとつ、",
    "g06.l012b": "大切な贈り物があるよ。",
    "g06.l013a": "「他にもあるの？　すごい！",
    "g06.l013b": "その贈り物のこと、教えて！」",
    "g06.l014a": "なくしたくない、",
    "g06.l014b": "言葉があるよ。",
    "g06.l015a": "「どんな言葉？",
    "g06.l015b": "どこかで見つけたの？",
    "g06.l015c": "誰かに言われたの？」",
    "g06.l016": "どんな言葉…。",
    "g06.l017a": "その言葉を思い出して",
    "g06.l017b": "どうして特別なのか、考えてみる。",
    "g06.l018a": "もうひとつ、",
    "g06.l018b": "大切な言葉があるよ。",
    "g06.l019a": "「他にもあるの？　すごい！",
    "g06.l019b": "その言葉のこと、教えて！」",
    "g06.l020a": "なくしたくない、",
    "g06.l020b": "宝物を持ってるよ。",
    "g06.l021a": "「どんなもの？",
    "g06.l021b": "どうやって見つけたの？」",
    "g06.l022a": "自分にとって",
    "g06.l022b": "あれがどうして宝物なのかを",
    "g06.l022c": "なんて説明したらいいか、考えてみる。",
    "g06.l023b": "宝物があるよ。",
    "g06.l024b": "その宝物のこと、教えて！」",
    "g06.l025a": "なくしたくない、",
    "g06.l025b": "目標があるよ。",
    "g06.l026a": "「どんな目標？",
    "g06.l026b": "いつからあるの？",
    "g06.l026c": "どうやってできたの？」",
    "g06.l027": "どんな目標…。",
    "g06.l028a": "いつから、どうやって…",
    "g06.l028b": "目標が生まれた時のことを",
    "g06.l028c": "思い出してみる。",
    "g06.l029b": "大切な目標があるよ。",
    "g06.l030b": "その目標のこと、教えて！」",
    "g06.l031a": "なくしたくない、",
    "g06.l031b": "思い出の場所があるよ。",
    "g06.l032a": "「どんな場所？",
    "g06.l032b": "どんな思い出があるの？」",
    "g06.l033": "あの場所の思い出…。",
    "g06.l034a": "どんな風に過ごして",
    "g06.l034b": "どんな思い出があるか、考えてみる。",
    "g06.l035b": "大切な場所があるよ。",
    "g06.l036b": "その場所のこと、教えて！」",
    "g06.l037a": "「どんなことでもいいから、",
    "g06.l037b": "教えてほしいな」",
    "g06.l038a": "待ちきれないというように、",
    "g06.l038b": "じっとこちらを見つめている。",
    "g06.l039a": "うまく言葉にできるだろうか。",
    "g06.l039b": "──でも、やってみよう。",
    "g06.l040a": "「ほかにもあったら、",
    "g06.l040b": "聞かせてほしいな」",
    "g06.ui001": "ここに書いてください",
    "g06.l041a": "「{value}",
    "g06.l041b": "…かぁ」",
    "g06.l042": "「…そうなんだね」",
    "g06.l043": "「教えてくれて、ありがとう」",
    "g06.l044a": "満足そうににっこりと",
    "g06.l044b": "微笑んだ、その時。",
    "g06.l045": "…あれ？",
    "g06.l046a": "あたりがほんのりと",
    "g06.l046b": "明るくなっていることに気づく。",
    "g06.l047a": "暗さに目が",
    "g06.l047b": "慣れただけかもしれない。",
    "g06.l048a": "「ねえ、{value}さんの",
    "g06.l048b": "なくしたくないもの、",
    "g06.l048c": "他にもある？」",
    "g06.c001": "もう少し話したい",
    "g06.c002": "もう思いつかない",
    "g06.l049": "…もう思いつかないかな。",
    "g06.l050": "「そっか。ありがとう」",
    "g06.l051a": "──自分が、",
    "g06.l051b": "なくしたくないもののこと。",
    "g06.l052a": "考えているうちに、",
    "g06.l052b": "気づいたらあたりの様子が",
    "g06.l052c": "変わっている。",
    "g06.l053a": "最初に目を開けた時は",
    "g06.l053b": "真っ暗で、霧に囲まれて、",
    "g06.l053c": "この子の泣き声だけが聞こえて。",
    "g06.l054": "すごく不安だった。",
    "g06.l055": "だけど、今は──。",
    "g06.l056": "「ここ、好き」",
    "g06.l057a": "隣で、心から安心した表情で",
    "g06.l057b": "あたりを見回している様子を見ると、",
    "g06.l057c": "それがずっと昔のことのように思える。",
    "g06.l058": "「…なんだか、安心する」",
    "g06.l059": "その言葉に小さくうなずくと、",
    "g06.l060a": "「{value}さんも、",
    "g06.l060b": "ここが好き？」",
    "g06.l061": "問いかけられて、考える。",
    "g07.c001": "好き",
    "g07.c002": "悪くない",
    "g07.c003": "今より好きになりたい",
    "g07.l001": "好き、かなあ。",
    "g07.l002a": "自分に言われたかのように",
    "g07.l002b": "嬉しそうに照れ笑いを見せる。",
    "g07.l003": "「よかったあ」",
    "g07.l004": "悪くない、かな。",
    "g07.l005a": "「そっか。",
    "g07.l005b": "悪くない、悪くない」",
    "g07.l006a": "満足そうにうなずきながら",
    "g07.l006b": "その言葉を繰り返しつぶやく。",
    "g07.l007": "今はまだ、そんなに…。",
    "g07.l008a": "だから、今より",
    "g07.l008b": "好きになりたいな。",
    "g07.l009b": "そういうの、いいね」",
    "g07.l010a": "少し驚いたように目を丸くしたあと、",
    "g07.l010b": "にっこりと微笑む。",
    "g08.l001a": "「{value}さんは、",
    "g08.l001b": "なくしたくないものを",
    "g08.l001c": "ちゃんと知ってる」",
    "g08.l002a": "「それだけで、",
    "g08.l002b": "じゅうぶんな気がする」",
    "g08.l003": "…そう、かな。",
    "g08.l004a": "気づけば、",
    "g08.l004b": "足もとに霧の切れ間が見えていた。",
    "g09.l001": "「ここに、ずっといたいな」",
    "g09.l002a": "そう言って、",
    "g09.l002b": "草の上にころんと寝転がる。",
    "g09.l003a": "「なくしたもの、",
    "g09.l003b": "探しに行かなくていいの？」",
    "g09.l004": "その隣にしゃがんで尋ねる。",
    "g09.l005": "「見つかったよ」",
    "g09.l006a": "「なくしたと思ってたもの、",
    "g09.l006b": "全部ここにあった」",
    "g09.l007": "──ここ。",
    "g09.l008a": "初めはなにも見えないくらい、",
    "g09.l008b": "濃い霧に包まれていた。",
    "g09.l009a": "気づいたら少しずつ晴れて、",
    "g09.l009b": "なんだか安心できるようになった",
    "g09.l009c": "この場所。",
    "g09.l010a": "「ここを作ってくれて、",
    "g09.l010b": "ありがとう」",
    "g09.l011a": "上半身を起こすと、",
    "g09.l011b": "こちらに顔を向けてそうつぶやく。",
    "g09.l012": "作った…？",
    "g09.l013a": "「\"{value}\"",
    "g09.l013b": "のこと、",
    "g09.l013c": "教えてくれたよね」",
    "g09.l014a": "「\"{value}\"",
    "g09.l014b": "のことも」",
    "g09.l016a": "「そのときから、",
    "g09.l016b": "すこしずつ、明るくなってった」",
    "g09.l017a": "──そういえば。",
    "g09.l017b": "あたりが明るくなってきたのは、",
    "g09.l018a": "\"なくしたくないもの\"を思い浮かべて",
    "g09.l018b": "この子に話した時だった。",
    "g09.l019": "じゃあ…。",
    "g09.l020a": "この森は、この景色は、",
    "g09.l020b": "自分の\"なくしたくないもの\"で",
    "g09.l020c": "できている。",
    "g09.l021a": "\"なくしたくないもの\"への",
    "g09.l021b": "想いで、できている。",
    "g09.l022": "──と、理解してもいいんだろうか。",
    "g09.l023a": "「なにもなくなったと思ったけど、",
    "g09.l023b": "なくなってなかったんだ」",
    "g09.l024a": "小さな手が、",
    "g09.l024b": "またそっと指を握る。",
    "g09.l025a": "「一緒に歩いてくれて、",
    "g09.l025b": "うれしかった」",
    "g09.l026": "その瞬間。",
    "g09.l027a": "どこからか風が吹き抜けて、",
    "g09.l027b": "まぶしいくらいの朝の光が",
    "g09.l027c": "森を包んでいく。",
    "g09.l028a": "驚いてあたりを見回すと、",
    "g09.l028b": "安心させるみたいに",
    "g09.l028c": "手を強く握られる。",
    "g09.l029a": "さっきまで握っていた手は、",
    "g09.l029b": "小さくて、柔らかくて、あたたかかった。",
    "g09.l030a": "だけど今握っている手は、",
    "g09.l030b": "乾いていて、骨ばっていて、少し冷たい。",
    "g09.l031a": "握った手のほうを見るけれど",
    "g09.l031b": "光のせいなのか、",
    "g09.l031c": "うまく顔が見えない。",
    "g09.l032a": "「\"その時\"が来れば、",
    "g09.l032b": "大切なものは",
    "g09.l032c": "失ってしまう」",
    "g09.l033a": "聞こえてきた声も",
    "g09.l033b": "かすれていて、少し震えている。",
    "g09.l034a": "この人は、",
    "g09.l034b": "誰？",
    "g09.l035a": "「だから、自分には",
    "g09.l035b": "なにもないように思えた」",
    "g09.l036": "「寂しくて、怖かった」",
    "g09.l037": "「──でも、そうじゃなかった」",
    "g09.l038a": "「\"なくしたくないもの\"は",
    "g09.l038b": "確かにあった」",
    "g09.l039a": "「ちゃんと、あの人のことを",
    "g09.l039b": "想っていたんだ」",
    "g09.l040a": "「あの贈りものを、",
    "g09.l040b": "大切にしていたんだ」",
    "g09.l041a": "「あの言葉は、",
    "g09.l041b": "胸に残っていたんだ」",
    "g09.l042a": "「あの宝物を、",
    "g09.l042b": "大事に想っていたんだ」",
    "g09.l043a": "「目標を持って、",
    "g09.l043b": "歩いてきたんだ」",
    "g09.l044a": "「戻りたい場所が",
    "g09.l044b": "ちゃんとあったんだ」",
    "g09.l045": "「…思い出させてくれて、ありがとう」",
    "g09.l046a": "その声が響くと、",
    "g09.l046b": "握っていた手の感触が消える。",
    "g09.l047a": "行方を探すけれど、",
    "g09.l047b": "不思議とわかっている。",
    "g09.l048a": "ここにいるのは、",
    "g09.l048b": "自分だけ。",
    "g09.l049": "…。",
    "g09.l050": "……違う。",
    "g09.l051a": "そもそも、最初からずっと",
    "g09.l051b": "自分だけだったんだろう。",
    "g10.l001a": "さっき問いかけられた言葉が",
    "g10.l001b": "もう一度頭に響く。",
    "g10.l002a": "「{value}さんのことが、",
    "g10.l002b": "好き？」",
    "g10.c001": "好き",
    "g10.c002": "悪くない",
    "g10.c003": "今より好きになりたい",
    "g10.l003": "好き、かなあ。",
    "g10.l004": "たぶん、そう思う。",
    "g10.l005": "悪くない、かな。",
    "g10.l006a": "好きとまでは言えなくても、",
    "g10.l006b": "嫌いではない。",
    "g10.l007a": "だから、今より",
    "g10.l008a": "気がつけば、",
    "g10.l008b": "霧はどこにもなかった。",
    "g10.l009a": "木々の隙間から、",
    "g10.l009b": "やわらかな朝の光が差し込んでいる。",
    "g10.l010a": "足もとには、",
    "g10.l010b": "小さな花がいくつも咲いていた。",
    "g10.l011a": "「もうここを出ていいよ」と",
    "g10.l011b": "言われているみたいに。",
    "g10.l012a": "大丈夫。",
    "g10.l012b": "もう、帰れる。",
    "g10.l013a": "まぶたを閉じて、",
    "g10.l013b": "深く息を吸い込む。",
    "g10.l014a": "もう一度目を開けると、",
    "g10.l014b": "見慣れた天井が見えた。",
    "g10.l015a": "霧も、",
    "g10.l015b": "子どもの声も、",
    "g10.l015c": "もうなにもない。",
    "g10.ui001": "「",
    "g10.ui002": "」",
    "g10.l016a": "という\"大切なもの\"は、",
    "g10.l016b": "はっきりと覚えていた。",
    "g10.l017a": "──さぁ、",
    "g10.l017b": "これからどうしようか。"

};

[endscript]

[return]